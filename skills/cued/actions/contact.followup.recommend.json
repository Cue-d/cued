{
  "type": "contact.followup.recommend",
  "version": "1",
  "description": "Record a harmless follow-up recommendation for a contact.",
  "module": "actions/record-effect.cjs",
  "requiresApprovalDefault": true,
  "effect": {
    "effectType": "contact.followup.recommended",
    "targetTable": "contacts",
    "targetExists": "contact",
    "targetIdField": "contactId",
    "resultKey": "recommendation"
  },
  "payload": {
    "required": {
      "contactId": "string",
      "reason": "string"
    },
    "optional": {
      "suggestedMessage": "string",
      "dueAt": "number",
      "evidence": "object"
    }
  }
}
