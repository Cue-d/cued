{
  "type": "contact.message.draft",
  "version": "1",
  "description": "Record a harmless drafted message for a contact without sending it.",
  "module": "actions/record-effect.cjs",
  "requiresApprovalDefault": true,
  "effect": {
    "effectType": "contact.message.drafted",
    "targetTable": "contacts",
    "targetExists": "contact",
    "targetIdField": "contactId",
    "resultKey": "draft"
  },
  "payload": {
    "required": {
      "contactId": "string",
      "body": "string",
      "reason": "string"
    },
    "optional": {
      "channelHint": "string",
      "evidence": "object",
      "confidence": "number"
    }
  }
}
